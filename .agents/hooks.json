{
  "wcag22-post-commit-a11y": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post_commit_a11y.mjs",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop_a11y_gate.mjs",
        "timeout": 15
      }
    ]
  }
}
